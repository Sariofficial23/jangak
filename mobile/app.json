{
  "expo": {
    "name": "Jangak.kg",
    "slug": "jangak",
    "owner": "sariofficial23s-team",
    "scheme": "jangak",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1E7A4C",
      "resizeMode": "contain"
    },
    "android": {
      "package": "kg.jangak.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E7A4C"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото, чтобы прикрепить их к объявлению."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cd2b5ee1-25ad-4348-8e69-cb0866265f42"
      }
    }
  }
}
